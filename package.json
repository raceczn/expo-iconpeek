{
  "name": "iconpeek",
  "version": "1.0.3",
  "description": "Live Expo app icon and splash preview with Android adaptive-icon mask checks - no native build required.",
  "main": "server.js",
  "bin": {
    "iconpeek": "./server.js"
  },
  "scripts": {
    "build:css": "tailwindcss -i src/input.css -o style.css --minify",
    "build:js": "esbuild src/index.tsx --bundle --minify --outfile=dist/bundle.js --target=es2020",
    "build": "npm run build:css && npm run build:js",
    "prepublishOnly": "npm run build && npm test",
    "start": "node server.js",
    "test": "node tests/smoke-test.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=14"
  },
  "files": [
    "server.js",
    "style.css",
    "index.html",
    "generate_icons.py",
    "README.md",
    "LICENSE",
    "assets/",
    "dist/"
  ],
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ionicons": "^8.1.0",
    "konsta": "^5.5.0",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  }
}
